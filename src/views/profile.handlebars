<div class="container">
    <div class="page-card">
        <h1>Личный кабинет</h1>

        <p>
            Пользователь:
            <strong>{{user.login}}</strong>
        </p>

        <h2 style="margin-top: 30px;">
            История заявок
        </h2>

        {{#each assignments}}
            <div class="assignment-card">
                <p>
                    <strong>
                        Заявка #{{this.assignment_id}}
                    </strong>
                </p>

                <p>
                    Транспорт:
                    {{this.transport_title}}
                </p>

                <p>
                    Дата начала:
                    {{formatDate this.start_date}}
                </p>

                <p>
                    Статус:
                    <span class="status">
                        {{this.status}}
                    </span>
                </p>

                <p>
                    Отзыв:

                    {{#if this.review_description}}
                        {{this.review_description}}
                    {{else}}
                        <i>нет отзыва</i>
                    {{/if}}
                </p>

                {{#unless this.review_description}}
                    <form action="/reviews" method="post">
                        <input
                            type="hidden"
                            name="assignment_id"
                            value="{{this.assignment_id}}"
                        />

                        <div class="form-group">
                            <textarea
                                name="description"
                                placeholder="Оставить отзыв"
                            ></textarea>
                        </div>

                        <button class="btn" type="submit">
                            Отправить отзыв
                        </button>
                    </form>
                {{/unless}}
            </div>
        {{/each}}
    </div>
</div>