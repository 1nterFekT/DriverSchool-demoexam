<h1>Оформление заявки на обучение</h1>

{{#if error}}
    <p>{{error}}</p>
{{/if}}

{{#if success}}
    <p>{{success}}</p>
{{/if}}

<form action="/assignments" method="post">
    <div>
        <label>Транспорт:</label>
        <select name="transport_id" required>
            {{#each transports}}
                <option value="{{this.id}}">{{this.title}}</option>
            {{/each}}
        </select>
    </div>

    <br />

    <div>
        <label>Дата начала обучения:</label>
        <input
            type="datetime-local"
            name="start_date"
            min="{{currentDate}}"
            required
        />
    </div>

    <br />

    <div>
        <label>Способ оплаты</label>
        <br />
        <label>
            <input type="radio" name="payment_type" value="Наличные" required />
            Наличные
        </label>
        <label>
            <input type="radio" name="payment_type" value="Безналичные" />
            Безналичные
        </label>
    </div>

    <br />

    <button type="submit">Создать заявку</button>
</form>

<script>
    const form = document.querySelector("form");

    form.addEventListener("submit", function (event) {
        const input = document.querySelector('[name="start_date"]');
        const selected = new Date(input.value);
        const now = new Date();

        if (selected <= now) {
            event.preventDefault();

            alert("Дата должна быть в будущем")
        }
    })
</script>