<div class="container">
    <div class="page-card">
        <h1>Оформление заявки на обучение</h1>

        {{#if error}}
            <div class="error">{{error}}</div>
        {{/if}}

        {{#if success}}
            <div class="success">{{success}}</div>
        {{/if}}

        <form action="/assignments" method="post">
            <div class="form-group">
                <label>Транспорт</label>

                <select name="transport_id" required>
                    {{#each transports}}
                        <option value="{{this.id}}">
                            {{this.title}}
                        </option>
                    {{/each}}
                </select>
            </div>

            <div class="form-group">
                <label>Дата начала обучения</label>

                <input
                    type="date"
                    name="start_date"
                    min="{{currentDate}}"
                    required
                />
            </div>

            <div class="form-group">
                <label>Способ оплаты</label>

                <div class="radio-group">
                    <label class="radio-item">
                        <input
                            type="radio"
                            name="payment_type"
                            value="Наличные"
                            required
                        />
                        Наличные
                    </label>

                    <label class="radio-item">
                        <input
                            type="radio"
                            name="payment_type"
                            value="Безналичные"
                        />
                        Безналичные
                    </label>
                </div>
            </div>

            <button class="btn" type="submit">
                Создать заявку
            </button>
        </form>
    </div>
</div>

<script>
    const form = document.querySelector("form");

    form.addEventListener("submit", function (event) {
        const input = document.querySelector('[name="start_date"]');

        const selected = new Date(input.value);

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (selected <= today) {
            event.preventDefault();

            alert("Дата должна быть в будущем");
        }
    });
</script>