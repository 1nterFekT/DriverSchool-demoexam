<h1>Панель администратора</h1>
<a href="/logout">Выйти</a>

<hr />

{{#each assignments}}
    <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
        <p><b>Заявка #{{this.id}}</b></p>
        <p>Пользователь: {{this.first_name}} {{this.last_name}}</p>
        <p>Транспорт: {{this.transport_title}}</p>
        <p>Дата начала обучения: {{this.start_date}}</p>
        <p>Статус: <b>{{this.status}}</b></p>

        <form action="/admin/status" method="post">
            <input type="hidden" name="assignment_id" value="{{this.id}}" />
            <select name="status">
                <option>Новая</option>
                <option>Идет обучение</option>
                <option>Обучение завершено</option>
            </select>
            <button type="submit">Обновить</button>
        </form>
    </div>
{{/each}}